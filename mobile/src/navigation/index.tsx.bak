// src/navigation/index.tsx
import React, { useEffect, useRef } from "react";
import {
  NavigationContainer,
  NavigationContainerRef,
} from "@react-navigation/native";
import { createNativeStackNavigator } from "@react-navigation/native-stack";
import * as Notifications from "expo-notifications";

import { useAuth } from "../hooks/useAuth";

import LoginScreen from "../screens/LoginScreen";
import BiometricLockScreen from "../screens/BiometricLockScreen";
import HomeScreen from "../screens/HomeScreen";
import FiliadosScreen from "../screens/FiliadosScreen";
import VotacoesScreen from "../screens/VotacoesScreen";
import VotacaoDetalheScreen from "../screens/VotacaoDetalheScreen";
import EventoScreen from "../screens/EventoScreen";

export type RootStackParamList = {
  Login: undefined;
  BiometricLock: undefined;

  Home: undefined;
  Eventos: undefined;

  Filiados: undefined;

  Votacoes: undefined;
  VotacaoDetalhe: { id: number };
};

const Stack = createNativeStackNavigator<RootStackParamList>();

type PendingNav =
  | { screen: "Eventos" }
  | { screen: "Votacoes" }
  | { screen: "VotacaoDetalhe"; id: number }
  | null;

export default function RootNavigation() {
  const { autenticado, carregando, bloqueadoPorBiometria } = useAuth() as any;

  const navigationRef =
    useRef<NavigationContainerRef<RootStackParamList> | null>(null);

  const pendingNavRef = useRef<PendingNav>(null);

  function tryConsumePendingNav() {
    const nav = navigationRef.current;
    const pending = pendingNavRef.current;

    if (!nav || !pending) return;
    if (!autenticado || bloqueadoPorBiometria) return;

    if (pending.screen === "Eventos") nav.navigate("Eventos");
    if (pending.screen === "Votacoes") nav.navigate("Votacoes");
    if (pending.screen === "VotacaoDetalhe") {
      nav.navigate("VotacaoDetalhe", { id: pending.id });
    }

    pendingNavRef.current = null;
  }

  // Listener: toque em push notification
  useEffect(() => {
    const sub = Notifications.addNotificationResponseReceivedListener(
      (response) => {
        const data = response?.notification?.request?.content?.data as any;
        if (!data) return;

        if (data.screen === "Eventos") {
          pendingNavRef.current = { screen: "Eventos" };
        } else if (data.screen === "Votacoes") {
          pendingNavRef.current = { screen: "Votacoes" };
        } else if (
          data.screen === "VotacaoDetalhe" &&
          (data.votacaoId ?? data.id) != null
        ) {
          const idNum = Number(data.votacaoId ?? data.id);
          if (!Number.isNaN(idNum)) {
            pendingNavRef.current = { screen: "VotacaoDetalhe", id: idNum };
          }
        }

        // tenta navegar imediatamente (se já puder)
        tryConsumePendingNav();
      }
    );

    return () => sub.remove();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [autenticado, bloqueadoPorBiometria]);

  // Quando login/biometria mudar, tenta consumir navegação pendente
  useEffect(() => {
    tryConsumePendingNav();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [autenticado, bloqueadoPorBiometria]);

  if (carregando) return null;

  return (
    <NavigationContainer
      ref={(ref) => {
        navigationRef.current = ref;
        tryConsumePendingNav();
      }}
    >
      <Stack.Navigator>
        {!autenticado ? (
          <Stack.Screen
            name="Login"
            component={LoginScreen}
            options={{ headerShown: false }}
          />
        ) : bloqueadoPorBiometria ? (
          <Stack.Screen
            name="BiometricLock"
            component={BiometricLockScreen}
            options={{ headerShown: false }}
          />
        ) : (
          <>
            <Stack.Screen
              name="Home"
              component={HomeScreen}
              options={{ title: "SINPRF/ES" }}
            />
            <Stack.Screen
              name="Eventos"
              component={EventoScreen}
              options={{ title: "Evento" }}
            />
            <Stack.Screen
              name="Filiados"
              component={FiliadosScreen}
              options={{ title: "Filiados (offline)" }}
            />
            <Stack.Screen
              name="Votacoes"
              component={VotacoesScreen}
              options={{ title: "Votações" }}
            />
            <Stack.Screen
              name="VotacaoDetalhe"
              component={VotacaoDetalheScreen}
              options={{ title: "Detalhes da votação" }}
            />
          </>
        )}
      </Stack.Navigator>
    </NavigationContainer>
  );
}
