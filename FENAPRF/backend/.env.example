# Configurações do Backend FENAPRF
# Renomeie para .env e preencha com os valores corretos

# Porta do servidor
PORT=3000

# Banco de Dados (PostgreSQL)
DATABASE_URL=postgres://usuario:senha@host:5432/banco

# Autenticação
JWT_SECRET=sua_chave_secreta_aqui

# URLs Base
APP_BASE_URL=https://fenaprf-exemplo.org.br
QR_VERIFICATION_URL=https://fenaprf-exemplo.org.br/verificar

# Ambiente (dev, hml, prod)
ASSEMBLEIA_ENV=dev

# Integrações de Terceiros
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
INSTAGRAM_TOKEN=seu_token_instagram_aqui
RESEND_API_KEY=re_sua_chave_aqui

# Google Drive (Publicações)
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account",...}
GOOGLE_DRIVE_FOLDER_ID=id_da_pasta_no_drive

# E-mails de Notificação
MAIL_FROM=FENAPRF <noreply@fenaprf-exemplo.org.br>
MAIL_TO_FILIACAO=secretaria@fenaprf-exemplo.org.br
MAIL_TO_RESSARCIMENTO=financeiro@fenaprf-exemplo.org.br
BIRTHDAY_REPORT_TO=secretaria@fenaprf-exemplo.org.br
REPORT_NOTIFY_EMAIL=admin@fenaprf-exemplo.org.br
REPORTS_COPY_EMAIL=arquivo@fenaprf-exemplo.org.br

# Configurações de Assembleia Piloto
ASSEMBLEIA_PILOTO_ATIVO=false
ASSEMBLEIA_PILOTO_ID=0
ASSEMBLEIA_SUPORTE_ATIVO=false
