{
  "name": "sinprfes-monorepo",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.x"
  },
  "pnpm": {
    "overrides": {
      "react": "19.1.0",
      "react-dom": "19.1.0",
      "react-native": "0.81.5"
    }
  },
  "scripts": {
    "preinstall": "node scripts/check-lockfiles.js",
    "install:all": "pnpm install",
    "build:backend": "pnpm --filter @sinprfes/backend run build",
    "start:backend": "pnpm --filter @sinprfes/backend run start",
    "build:site": "pnpm --filter @sinprfes/site run build",
    "start:site": "pnpm --filter @sinprfes/site run start",
    "build:assembleia": "pnpm --filter @sinprfes/assembleia-app run build"
  }
}
